# 复制为 backend/.env 后按需修改。所有变量都带 AITRADER_ 前缀。
# 默认用本地 SQLite 文件,零配置即可联调:
AITRADER_DATABASE_URL=sqlite:///./dev.db
# 用 docker compose 起 PostgreSQL 后改成:
# AITRADER_DATABASE_URL=postgresql+psycopg://aitrader:aitrader@localhost:5432/aitrader
AITRADER_ENABLE_DEV_ENDPOINTS=true
AITRADER_SEED_ON_START=true
AITRADER_CORS_ORIGINS=["http://localhost:3000"]
